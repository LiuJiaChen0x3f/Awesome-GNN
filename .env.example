# Set environment variables, or copy this file to .env (never commit .env).
LLM_BASE_URL=https://your-provider.example/v1
LLM_API_KEY=
LLM_MODEL=
LLM_REASONING_EFFORT=medium
# Optional. This project's OpenAlex adapter requires a key for unattended access.
OPENALEX_API_KEY=
# Optional contact address for Crossref polite pool and arXiv User-Agent.
CONTACT_EMAIL=
